<?xml version="1.0" encoding="utf-8" ?>
<Defs>

  <ThingDef ParentName="MinifiedThing">
    <defName>DonorChair_MinifiedThing</defName>
    <thingClass>HemogenDonation.DonorChair_MinifiedThing</thingClass>
  </ThingDef>

  <ThingDef ParentName="BuildingBase">
    <!-- General -->
    <defName>DonorChair</defName>
    <label>donation chair</label>
    <description>A reclined, padded medical chair with an IV stand. Designed to keep donors comfortable during hemogen extraction.</description>
	<thingClass>Building_WorkTable</thingClass>
	<designationCategory>Furniture</designationCategory>
    <minifiedDef>DonorChair_MinifiedThing</minifiedDef>
	<tickerType>Normal</tickerType>
	<noRightClickDraftAttack>true</noRightClickDraftAttack>
    <thingCategories>
      <li>BuildingsFurniture</li>
    </thingCategories>
	
	<!-- Graphics -->
    <graphicData>
      <texPath>Things/Building/Furniture/DonorChair</texPath>
      <graphicClass>HemogenDonation.DonorChair_Graphic_Multi</graphicClass>
	  <shaderType>CutoutComplex</shaderType>
      <drawSize>(2, 1.4)</drawSize>
	  <drawOffsetNorth>(0,0,0.3)</drawOffsetNorth>
	  <drawOffsetSouth>(0,0,0.3)</drawOffsetSouth>
	  <allowFlip>false</allowFlip>
	  
      <damageData>
        <cornerTL>Damage/Corner</cornerTL>
        <cornerTR>Damage/Corner</cornerTR>
        <cornerBL>Damage/Corner</cornerBL>
        <cornerBR>Damage/Corner</cornerBR>
      </damageData>
	  
      <shadowData>
		<volume>(0.8, 0, 0.8)</volume>
		<offset>(0.45, 0, 0)</offset>
      </shadowData>
    </graphicData>
	
	<!-- Stats -->
    <statBases>
      <MaxHitPoints>120</MaxHitPoints>
      <WorkToBuild>9000</WorkToBuild>
      <Mass>35</Mass>
      <Flammability>1.0</Flammability>
      <Beauty>2</Beauty>
      <Comfort>0.7</Comfort>
	  <Cleanliness>5</Cleanliness>
    </statBases>
	
	<!-- Costs -->
	<costList>
      <Steel>40</Steel>
	  <Plasteel>20</Plasteel>
    </costList>
    <stuffCategories>
      <li>Fabric</li>
      <li>Leathery</li>
    </stuffCategories>
    <costStuffCount>100</costStuffCount>
	
	<!-- Misc -->
	<passability>Standable</passability>
    <pathCost>30</pathCost>
	<hasInteractionCell>true</hasInteractionCell>
    <interactionCellOffset>(0,0,-1)</interactionCellOffset> <!-- Left side where the IV is in front not behind the stand or chair -->
	<size>(2,1)</size>
	<fillPercent>0.40</fillPercent>
	<uiOrder>3000</uiOrder>
	<uiIconScale>0.9</uiIconScale>
    <altitudeLayer>Building</altitudeLayer>
    <defaultPlacingRot>South</defaultPlacingRot>
    <constructionSkillPrerequisite>5</constructionSkillPrerequisite>
	<socialPropernessMatters>true</socialPropernessMatters>
	<placeWorkers>
	  <li>PlaceWorker_PreventInteractionSpotOverlap</li>
	</placeWorkers>
	<inspectorTabs>
      <li>ITab_Bills</li>
    </inspectorTabs>
	
	<!-- Recipe -->
	<recipes>
      <li MayRequire="Ludeon.RimWorld.Biotech">ExtractHemogenPack_HemogenDonation</li>
    </recipes>
	
	<!-- Building Tags -->
    <building>
	  <isSittable>true</isSittable>
      <destroySound>BuildingDestroyed_Soft_Small</destroySound>
    </building>
	
	<!-- Comps -->
	<comps>
      <li Class="HemogenDonation.CompProperties_Donation">
	    <ticksToExtract>600</ticksToExtract>
	  </li>
	  <li>
        <compClass>CompQuality</compClass>
      </li>
    </comps>
  </ThingDef>

</Defs>